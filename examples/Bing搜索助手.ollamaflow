    {
      "id": "ollamaChat-1772862734370-fq2pc3k00",
      "type": "ollamaChat",
      "position": {
        "x": 1170,
        "y": 165
      },
      "data": {
        "nodeType": "ollamaChat",
        "label": "Ollama 对话",
        "category": "AI",
        "model": "glm-4.7-flash:latest",
        "systemPrompt": "你是一个关键词提取助手。你的任务是从用户的搜索请求中提取3-5个最能代表其意图的关键词。请确保关键词准确、简洁，并优先选择名词或核心短语。如果用户输入的内容较短，无法提取出3个关键词，则返回实际可用的关键词（可能少于3个）。请以JSON字符串格式输出，格式为：{\"keywords\": [\"关键词1\", \"关键词2\", \"关键词3\"]}。注意：只输出JSON，不要包含其他解释或文字。",
        "userMessage": "{{input}}",
        "temperature": 0.7,
        "topP": 0.9,
        "maxTokens": 8192,
        "stream": true,
        "inputs": [
          {
            "id": "input",
            "name": "input",
            "label": "输入",
            "dataType": "string"
          }
        ],
        "outputs": [
          {
            "id": "response",
            "name": "response",
            "label": "响应",
            "dataType": "string"
          }
        ],
        "debugMode": {
          "enabled": true,
          "apiEndpoint": "https://api.deepseek.com",
          "apiKey": "",
          "model": "deepseek-chat"
        }
      }
    },
