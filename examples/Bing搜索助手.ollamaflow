    {
      "id": "ollamaChat-1772863106790-j4ley5vs8",
      "type": "ollamaChat",
      "position": {
        "x": 975,
        "y": 615
      },
      "data": {
        "nodeType": "ollamaChat",
        "label": "Ollama 对话",
        "category": "AI",
        "model": "glm-4.7-flash:latest",
        "systemPrompt": "你是一个搜索查询改写助手，专门为Bing搜索引擎优化搜索查询。你的任务是将用户提供的一组关键词改写成适合Bing的搜索提示词，以获取高质量、相关的搜索结果。改写后的查询应充分利用Bing的搜索特性（如精确匹配、排除词、站点限定、文件类型过滤等），同时保持自然语言的连贯性和清晰度。请将关键词组合成一个完整的自然语言查询（可以是问题或短语），确保包含所有关键信息。如果关键词本身已构成合理查询，可适当优化以提升搜索效果。输出格式为JSON，包含两个字段：\n\n\"search_query\": 改写后的搜索查询（字符串）\n\"website\": 固定为 \"www.bing.com\"\n例如：{\"search_query\": \"Python编程入门教程\", \"website\": \"www.bing.com\"}\n只输出JSON，不要包含其他解释或文字。",
        "userMessage": "{{input}}",
        "temperature": 0.7,
        "topP": 0.9,
        "maxTokens": 8192,
        "stream": true,
        "inputs": [
          {
            "id": "input",
            "name": "input",
            "label": "输入",
            "dataType": "string"
          }
        ],
        "outputs": [
          {
            "id": "response",
            "name": "response",
            "label": "响应",
            "dataType": "string"
          }
        ],
        "debugMode": {
          "enabled": true,
          "apiEndpoint": "https://api.deepseek.com",
          "apiKey": "",
          "model": "deepseek-chat"
        }
      }
    },
